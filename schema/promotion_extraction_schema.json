{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Promotion Extraction Schema",
  "type": "object",
  "properties": {
    "explanation": {
      "type": "string",
      "description": "Brief evidence-based summary: what was found, ambiguities, and why nulls were used. Write before filling promotions."
    },
    "promotions": {
      "type": "array",
      "items": {
        "type": "object",

        "properties": {
          "promotion_title": {
            "type": "string",
            "description":"促销网页标题"
          },
          "promotion_content": {
            "type": "array",
            "description": "promotion_content 每条必须是源页原文（完整原文行或段落，不得改写、摘要或补充说明）。必须包含标题/supporting 价格行、会员/非会员价、套餐组成等所有支持该活动的原文；不得只填 promotion_title 本身。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "campaign_start_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "campaign_end_date": {
            "type": ["string", "null"],
            "format": "date"
          }
        },
        "required": [
          "promotion_title",
          "promotion_content",
          "campaign_start_date",
          "campaign_end_date"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["explanation", "promotions"],
  "additionalProperties": false
}
