{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Promotion Extraction Schema",
  "type": "object",
  "properties": {
    "explanation": {
      "type": "string",
      "description": "Brief evidence-based summary: what was found, ambiguities, and why nulls were used. Write before filling promotions."
    },
    "promotions": {
      "type": "array",
      "items": {
        "type": "object",

        "properties": {
          "promotion_title": {
            "type": "string",
            "description":"促销网页标题"
          },
          "promotion_content": {
            "type": "array",
            "description": "promotion_content 每条是一个能在源页面上追溯的事实：允许改写，但服务、价格、原价、折扣、数量、日期和条件都必须出现在页面上，并且属于这一个优惠。必须包含标题与支持价格的行、会员/非会员价、套餐组成等支持该活动的内容；不得只填 promotion_title 本身。不得合并页面上不同位置的内容，不得加入说明、推断、计算出的数值，不得包含链接、图片标记或网址。",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "campaign_start_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "campaign_end_date": {
            "type": ["string", "null"],
            "format": "date"
          }
        },
        "required": [
          "promotion_title",
          "promotion_content",
          "campaign_start_date",
          "campaign_end_date"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["explanation", "promotions"],
  "additionalProperties": false
}
